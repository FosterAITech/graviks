# Copy to .env for local development. On Vercel, add these under Project Settings > Environment Variables.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/garviks
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=graviks@gmail.com
ADMIN_PASSWORD=choose-a-strong-password
# Your website address(es), comma separated, e.g. https://garviks.vercel.app
CLIENT_URL=
